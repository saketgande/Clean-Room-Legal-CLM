APP_NAME="Clean Room Legal CLM"
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://legal_clm:replace-with-strong-password@localhost:5432/legal_clm
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=/var/lib/aegis/contracts

SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SETUP_TOKEN=replace-with-a-random-setup-token

ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain,image/png,image/jpeg
MAX_UPLOAD_SIZE_BYTES=52428800

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
MOCK_CLAUDE=false
AI_STORE_RAW_OUTPUTS=false
AI_MAX_TOOL_ITERATIONS=8
AI_DEFAULT_TEMPERATURE=0
CLAUDE_DAILY_TOKEN_CAP_PER_ORG=5000000
CLAUDE_MAX_TOKENS_CEILING=8000

REDUCTO_API_KEY=
MOCK_REDUCTO=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=legal-clm@example.com
MOCK_RESEND=false

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_REST_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_CONNECT_HMAC_KEY=replace-with-docusign-connect-hmac-key
MOCK_DOCUSIGN=false

ALLOW_DEV_RESET=false
DEV_SEED_ADMIN_EMAIL=admin@example.com
DEV_SEED_ADMIN_PASSWORD=local-dev-password

CORS_ORIGINS=https://aegis.ctpsandbox.com
CORS_ALLOW_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-CSRF-Token
ALLOWED_HOSTS=aegis.ctpsandbox.com,localhost,127.0.0.1
# --- TLS / proxy trust (these two are coupled — read before changing) -------
# nginx terminates TLS and forwards plain HTTP, setting X-Forwarded-Proto and
# X-Forwarded-For. uvicorn trusts those headers ONLY from the addresses in
# FORWARDED_ALLOW_IPS (default: 127.0.0.1 alone).
#
# Two things break when nginx is NOT on 127.0.0.1 relative to this process:
#   1. Rate limiting keys unauthenticated traffic (e.g. /auth/login) on the
#      remote IP. Untrusted headers mean every request looks like it comes from
#      nginx, collapsing per-IP brute-force protection into ONE global bucket —
#      a single attacker can then lock every user out of login.
#   2. FORCE_HTTPS=true would see scheme "http" and redirect forever.
#
# So: set FORWARDED_ALLOW_IPS to the nginx source IP first, then FORCE_HTTPS
# =true to ship HSTS. Leaving FORCE_HTTPS=false means NO HSTS header even
# though the site is HTTPS-only.
# NOTE: deploy/nginx/aegis.conf points at 10.1.127.3:8000 (a separate VM) while
# deploy/systemd/aegis-api.service binds 127.0.0.1:8000 (same host only). Those
# cannot both be right — confirm the real topology and fix one of them.
FORWARDED_ALLOW_IPS=127.0.0.1
FORCE_HTTPS=false

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

REFRESH_COOKIE_NAME=aegis_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=true
EXPOSE_REFRESH_TOKEN_IN_BODY=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_INVITATION_ACCEPT=5/minute
RATE_LIMIT_ASSISTANT_STREAM=10/minute
RATE_LIMIT_CONTRACT_UPLOAD=20/minute
RATE_LIMIT_AI_SKILL=20/minute

APPROVAL_DEFAULT_DUE_DAYS=7

EXPOSE_PASSWORD_RESET_TOKEN_IN_RESPONSE=false

REQUEST_LOG_REDACT_QUERY=true
REQUEST_LOG_SENSITIVE_QUERY_KEYS=token,passcode,refresh_token,access_token,api_key,setup_token

CLAUDE_MAX_RETRIES=3
CLAUDE_RETRY_INITIAL_BACKOFF_SECONDS=1.0
CLAUDE_RETRY_MAX_BACKOFF_SECONDS=30.0

UPLOAD_STREAM_CHUNK_BYTES=1048576
PDF_MAX_EXTRACTED_TEXT_BYTES=8388608

STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=

ENABLE_CLAMAV=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

ENABLE_RLS=false

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
ENABLE_METRICS=false

CORS_MAX_AGE_SECONDS=600
APP_BASE_URL=https://aegis.ctpsandbox.com

# --- Retrieval / embeddings -------------------------------------------------
# Switching EMBEDDING_PROVIDER to voyage changes the vector width (384 -> 1024),
# which needs a pgvector column migration plus a full re-embed. Leave on local
# unless you are doing exactly that.
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-law-2
VOYAGE_RERANK_MODEL=rerank-2
RERANK_PROVIDER=local
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
CONTEXTUAL_CHUNKING=true
# Must stay false in production: when fastembed is unavailable this would write
# random vectors instead of failing, making every retrieval result noise.
ALLOW_MOCK_EMBEDDINGS=false

# --- Storage ----------------------------------------------------------------
# This deploy IS single-host (see deploy/systemd — api, worker, beat and frontend
# all run on the one VM alongside STORAGE_ROOT), so the opt-in is correct here.
# Set this false and move to STORAGE_BACKEND=s3 the moment a second instance
# exists, or half the contract files 404.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true

# Every authenticated user becomes an org admin while this is on. Never true here.
DISABLE_RBAC=false

# --- Intake -----------------------------------------------------------------
# Unhides agents flagged not-production-ready. Must stay false for real tenants.
INTAKE_DEMO_AGENTS=false
INTAKE_GMAIL_ADDRESS=
INTAKE_GMAIL_APP_PASSWORD=
INTAKE_GMAIL_FOLDER=INBOX
INTAKE_GMAIL_MAX_MESSAGES=20

# --- Optional external lookups ----------------------------------------------
SEARCH_PROVIDER_API_KEY=
MOCK_SERPER=false
SIGNA_API_KEY=
SIGNA_OFFICES=
MOCK_SIGNA=false
TMSEARCH_API_KEY=
MOCK_TMSEARCH=false
