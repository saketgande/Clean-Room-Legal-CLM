[Unit]
Description=AEGIS Legal CLM API
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/aegis/backend
EnvironmentFile=/etc/aegis/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aegis/backend/.venv/bin/gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --workers 4 --bind 127.0.0.1:8000 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
