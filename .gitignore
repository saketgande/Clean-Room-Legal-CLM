AEGIS/
mike/
# OS / editor
.DS_Store
**/.DS_Store
.vs/

# Local dev-server logs (start.sh "without Docker" path writes these to repo root)
*.log

# Secrets & environment (never commit)
backend/.env
backend/.env.*
!backend/.env.example
backend/secrets/
**/*.pem
**/*.key

# Docker stack env (real file is local-only; the .example is committed)
.env.docker
.env.docker.local
!.env.docker.example

# Python virtualenvs (never commit)
env/
venv/
.venv/
**/__pycache__/
**/*.py[cod]

# Backend caches / local data
backend/.local-contract-storage/
backend/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.ruff_cache/
backend/.venv/
backend/build/
backend/dist/
backend/*.egg-info/

# Frontend build / deps
frontend/node_modules/
frontend/.next/
frontend/.turbo/
frontend/*.tsbuildinfo
frontend/.env.local
frontend/.env.production

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# `make phase1` output. Every report carries a contract's full text, so it must
# never be committed.
backend/docstudio_out/

# Local database / file backups (never commit)
backups/
