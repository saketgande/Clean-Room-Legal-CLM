# ---------------------------------------------------------------------------
# Local backend config.  One-time setup:
#     cp backend/.env.example backend/.env
#
# Defaults run the whole app locally with integration mocks ON, so no real API
# keys are required. To use a real integration, flip its MOCK_* flag to false
# and fill in the key, then `make dev` (recreates containers to pick up env).
#
# DATABASE_URL, REDIS_URL and STORAGE_ROOT are intentionally NOT set here —
# docker-compose.yml pins them to the in-stack postgres/redis + contracts
# volume, overriding anything set here.
# ---------------------------------------------------------------------------

APP_NAME="Clean Room Legal CLM"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Dev-only placeholders — generate real random values before any real deploy.
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SETUP_TOKEN=local-setup-token

ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain,image/png,image/jpeg
MAX_UPLOAD_SIZE_BYTES=52428800

# Integration mocks — ON for keyless local runs. Flip to false + add the key
# to exercise the real service.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
MOCK_CLAUDE=true
AI_STORE_RAW_OUTPUTS=false
AI_MAX_TOOL_ITERATIONS=8
AI_DEFAULT_TEMPERATURE=0
CLAUDE_DAILY_TOKEN_CAP_PER_ORG=5000000
CLAUDE_MAX_TOKENS_CEILING=8000

# Retrieval quality (Contract Brain / Search) — all default to local, no-key
# behavior. embedding_provider "voyage" requires a 1024-dim migration + full
# re-embed (pgvector columns are fixed-dimension); don't switch without that.
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-law-2
CONTEXTUAL_CHUNKING=false
# Cross-encoder reranker — the standard second stage that lifts retrieval
# precision after hybrid dense+FTS search. Off (rerank_provider=none) until you
# set a provider AND its key below.
RERANK_PROVIDER=none
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
VOYAGE_RERANK_MODEL=rerank-2

REDUCTO_API_KEY=
MOCK_REDUCTO=true

# Trademarks module - external similarity-search providers (all optional)
SIGNA_API_KEY=
SIGNA_OFFICES=
MOCK_SIGNA=true

TMSEARCH_API_KEY=
MOCK_TMSEARCH=true

SEARCH_PROVIDER_API_KEY=
MOCK_SERPER=true

RESEND_API_KEY=
RESEND_FROM_EMAIL=legal-clm@example.com
MOCK_RESEND=true

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_REST_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_CONNECT_HMAC_KEY=
MOCK_DOCUSIGN=true

ALLOW_DEV_RESET=false
DEV_SEED_ADMIN_EMAIL=admin@example.com
DEV_SEED_ADMIN_PASSWORD=local-dev-password

# --- CORS / hosts (browser hits the API on localhost:8000 from :3000) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
ALLOWED_HOSTS=*
FORCE_HTTPS=false

# --- SQLAlchemy connection pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# --- Refresh token cookie (HttpOnly) ---
REFRESH_COOKIE_NAME=aegis_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
EXPOSE_REFRESH_TOKEN_IN_BODY=true

# --- Rate limits (shared across workers via Redis) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_INVITATION_ACCEPT=5/minute
RATE_LIMIT_ASSISTANT_STREAM=10/minute
RATE_LIMIT_CONTRACT_UPLOAD=20/minute
RATE_LIMIT_AI_SKILL=20/minute

APPROVAL_DEFAULT_DUE_DAYS=7

EXPOSE_PASSWORD_RESET_TOKEN_IN_RESPONSE=false

REQUEST_LOG_REDACT_QUERY=true
REQUEST_LOG_SENSITIVE_QUERY_KEYS=token,passcode,refresh_token,access_token,api_key,setup_token

CLAUDE_MAX_RETRIES=3
CLAUDE_RETRY_INITIAL_BACKOFF_SECONDS=1.0
CLAUDE_RETRY_MAX_BACKOFF_SECONDS=30.0

UPLOAD_STREAM_CHUNK_BYTES=1048576
PDF_MAX_EXTRACTED_TEXT_BYTES=8388608

# --- Object storage. "local" writes under STORAGE_ROOT (the contracts volume). ---
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=

# --- Antivirus (ClamAV) — off for local. ---
ENABLE_CLAMAV=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
ENABLE_METRICS=false

CORS_MAX_AGE_SECONDS=600

# --- Public base URL of the web app (clickable email links) ---
APP_BASE_URL=http://localhost:3000

# --- Legal Intake: "Sync With Email" Gmail inbox sync (IMAP + App Password) ---
# Inert until both are set. Generate an App Password (requires 2FA on the
# Gmail account) at https://myaccount.google.com/apppasswords — do NOT use
# the account's normal login password here.
INTAKE_GMAIL_ADDRESS=
INTAKE_GMAIL_APP_PASSWORD=
INTAKE_GMAIL_FOLDER=INBOX
INTAKE_GMAIL_MAX_MESSAGES=20
