APP_NAME="Clean Room Legal CLM"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://legal_clm:legal_clm@localhost:5432/legal_clm
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./.local-contract-storage

SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SETUP_TOKEN=local-setup-token

ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain,image/png,image/jpeg
MAX_UPLOAD_SIZE_BYTES=52428800

# Integration mocks default to FALSE in code (production-safe). Local dev
# opts back IN here so you don't need real API keys to run the stack.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
MOCK_CLAUDE=true
# Persisting raw model outputs is off by default; flip on for local debugging.
AI_STORE_RAW_OUTPUTS=false
AI_MAX_TOOL_ITERATIONS=8
AI_DEFAULT_TEMPERATURE=0
# Claude spend guardrails (input+output tokens/day per org; per-call ceiling).
CLAUDE_DAILY_TOKEN_CAP_PER_ORG=5000000
CLAUDE_MAX_TOKENS_CEILING=8000

REDUCTO_API_KEY=
MOCK_REDUCTO=true

RESEND_API_KEY=
RESEND_FROM_EMAIL=legal-clm@example.com
MOCK_RESEND=true

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_REST_BASE_URL=https://demo.docusign.net/restapi
# Required in production once MOCK_DOCUSIGN=false (verifies Connect webhooks).
DOCUSIGN_CONNECT_HMAC_KEY=
MOCK_DOCUSIGN=true

ALLOW_DEV_RESET=false
DEV_SEED_ADMIN_EMAIL=admin@example.com
DEV_SEED_ADMIN_PASSWORD=local-dev-password

# --- CORS / hosts ---
# Comma-separated; production must NOT use '*'.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-CSRF-Token
ALLOWED_HOSTS=*
FORCE_HTTPS=false

# --- SQLAlchemy connection pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# --- Refresh token cookie (HttpOnly) ---
REFRESH_COOKIE_NAME=aegis_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# Legacy clients can still read refresh_token from the JSON body when this is on.
# MUST be false in production.
EXPOSE_REFRESH_TOKEN_IN_BODY=true

# --- Rate limits ---
# Counters are shared across workers via REDIS_URL (slowapi storage backend).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_PASSWORD_RESET=5/minute
RATE_LIMIT_INVITATION_ACCEPT=5/minute
RATE_LIMIT_ASSISTANT_STREAM=10/minute
RATE_LIMIT_CONTRACT_UPLOAD=20/minute
RATE_LIMIT_AI_SKILL=20/minute

APPROVAL_DEFAULT_DUE_DAYS=7

# --- Dev affordances; MUST be false in production ---
EXPOSE_PASSWORD_RESET_TOKEN_IN_RESPONSE=false

# --- Request log redaction ---
REQUEST_LOG_REDACT_QUERY=true
REQUEST_LOG_SENSITIVE_QUERY_KEYS=token,passcode,refresh_token,access_token,api_key,setup_token

# --- Claude resiliency ---
CLAUDE_MAX_RETRIES=3
CLAUDE_RETRY_INITIAL_BACKOFF_SECONDS=1.0
CLAUDE_RETRY_MAX_BACKOFF_SECONDS=30.0

# --- Upload safety ---
UPLOAD_STREAM_CHUNK_BYTES=1048576
PDF_MAX_EXTRACTED_TEXT_BYTES=8388608

# --- Object storage ---
# "local" writes under STORAGE_ROOT (default). "s3" targets the bucket below.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=

# --- Antivirus (ClamAV) ---
# Off for local dev / CI. Enable + point at clamd.
ENABLE_CLAMAV=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Postgres row-level security ---
# Off by default; when on, sessions set app.current_org_id for RLS policies.
ENABLE_RLS=false

# --- Observability ---
# Leave SENTRY_DSN empty to disable error reporting entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Expose Prometheus metrics at /metrics.
ENABLE_METRICS=false

# --- CORS preflight cache (Access-Control-Max-Age, seconds) ---
CORS_MAX_AGE_SECONDS=600

# --- Public base URL of the web app (clickable email links) ---
# MUST be a public https URL in production (http://localhost is rejected).
APP_BASE_URL=http://localhost:3000
