# Keep the build context small and free of host-only / secret files.
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Secrets & local env (never bake into an image)
.env
.env.*
!.env.example

# Local runtime artifacts
.local-contract-storage/
celerybeat-schedule*
status_ok
*.log

# Tests are not needed in the runtime image
tests/

# AI evaluation exam (specs/005-ai-eval-baseline, FR-36): client contracts, OCR
# output, label sheets and the dedicated exam key must never be baked into an image
eval/private/
eval/contracts/
eval/.work/
eval/**/*.xlsx
