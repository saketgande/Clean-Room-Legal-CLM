      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ],
    "older_may_lack": true,
    "fills": [
     "company_contact"
    ]
   },
   {
    "key": "company_contact_role",
    "label": "Company contact: role",
    "kind": "text",
    "required": true,
    "max_length": 120,
    "no_blanks": true,
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ],
    "older_may_lack": true,
    "fills": [
     "company_contact"
    ]
   },
   {
    "key": "nonstandard",
    "label": "Non-standard terms the customer asked for",
    "kind": "textarea",
    "required": false,
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Selling to a customer",
       "Something else"
      ]
     }
    ]
   },
   {
    "key": "personal_data",
    "label": "Will personal data be shared or processed?",
    "kind": "select",
    "required": true,
    "options": [
     "Yes",
     "No"
    ]
   },
   {
    "key": "gxp",
    "label": "Is this GxP or other regulated quality work?",
    "kind": "select",
    "required": true,
    "options": [
     "Yes",
     "No"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     }
    ]
   },
   {
    "key": "note_approvers",
    "label": "Note to approvers",
    "kind": "textarea",
    "required": false
   }
  ]
 },
 {
