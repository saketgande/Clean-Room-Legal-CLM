    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ],
    "older_may_lack": true,
    "fills": [
