      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ],
    "older_may_lack": true,
    "fills": [
     "consultancy_fee_basis"
    ]
   },
   {
    "key": "fee_rate",
    "label": "Rate per day or hour",
    "kind": "number",
    "required": true,
    "min_exclusive": 0,
    "max_decimals": 2,
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     },
     {
      "field": "fee_basis",
      "in": [
       "Day rate",
       "Hourly rate"
      ]
     }
    ],
    "older_may_lack": true,
    "fills": [
     "consultancy_fee_basis"
    ]
   },
   {
