      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     }
    ],
    "min_exclusive": 0,
    "rules_when": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ]
   },
   {
    "key": "currency",
    "label": "Currency",
    "kind": "select",
    "required": true,
    "options": [
     "INR",
     "USD",
     "EUR",
     "GBP"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     }
    ]
   },
   {
    "key": "start_date",
    "label": "Start date",
    "kind": "date",
    "required": true
   },
   {
    "key": "term",
    "label": "Term",
    "kind": "select",
    "required": true,
    "options": [
     "Fixed end date",
     "Renews automatically",
     "No end date (evergreen)"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     }
    ]
   },
   {
    "key": "end_date",
    "label": "End date",
    "kind": "date",
    "required": true,
    "not_before": "start_date",
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     },
     {
      "field": "term",
      "in": [
       "Fixed end date",
       "Renews automatically"
      ]
     }
    ]
   },
   {
    "key": "renewal_term",
    "label": "Each renewal lasts",
    "kind": "select",
    "required": true,
    "options": [
     "1 year",
     "2 years",
     "3 years"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     },
     {
      "field": "term",
      "in": [
       "Renews automatically"
      ]
     }
    ]
   },
   {
    "key": "notice_days",
    "label": "Notice needed to stop it renewing",
    "kind": "select",
    "required": true,
    "options": [
     "30 days",
     "60 days",
     "90 days"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Buying from a vendor",
       "Software or SaaS",
       "Consultancy",
       "Selling to a customer",
       "Something else"
      ]
     },
     {
      "field": "term",
      "in": [
       "Renews automatically"
      ]
     }
    ]
   },
   {
    "key": "scope",
    "label": "Scope of services",
    "kind": "textarea",
    "required": true,
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Services (MSA)",
       "Consultancy",
       "Something else"
      ]
     }
    ],
    "no_blanks": true,
    "rules_when": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ]
   },
   {
    "key": "advice_only",
    "label": "Advice only",
    "kind": "multiselect",
    "required": false,
    "options": [
     "There are no separate deliverables (advice only)"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ],
    "fills": [
     "consultancy_deliverables"
    ]
   },
   {
    "key": "consultancy_deliverables",
    "label": "Deliverables",
    "kind": "rows",
    "required": true,
    "min_rows": 1,
    "max_rows": 20,
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Consultancy"
      ]
     },
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     },
     {
      "field": "advice_only",
      "in": [
       "There are no separate deliverables (advice only)"
      ],
      "not": true
     }
    ],
    "older_may_lack": true,
    "fills": [
     "consultancy_deliverables"
    ],
    "columns": [
     {
      "key": "name",
      "label": "Deliverable name",
      "kind": "text",
      "max_length": 200,
      "unique": true,
      "no_blanks": true
     },
     {
      "key": "due",
      "label": "Due date",
      "kind": "date",
      "within": [
       "start_date",
       "end_date"
      ],
      "open_end": true
     }
    ]
   },
   {
    "key": "buying",
    "label": "What are we buying?",
    "kind": "select",
    "required": true,
    "options": [
     "Goods",
     "Services",
     "Goods and services"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Buying from a vendor"
      ]
     }
    ]
   },
   {
    "key": "hosting",
    "label": "Where will our data be hosted?",
    "kind": "select",
    "required": true,
    "options": [
     "India",
     "European Union",
     "United States",
     "Several regions"
    ],
    "show": [
     {
      "field": "agreement_type",
      "in": [
       "Software or SaaS"
      ]
     }
    ]
   },
   {
