   {
    "key": "processing_purpose",
    "label": "Why is the data processed?",
    "kind": "textarea",
    "required": true,
    "no_blanks": true,
    "rules_when": [
     {
      "field": "paper",
      "in": [
       "Our template"
      ]
     }
    ],
    "fills": [
     "processing_purpose"
    ]
   },
   {
    "key": "data_types",
    "label": "What kind of personal data?",
    "kind": "multiselect",
    "required": true,
    "options": [
     "Contact and identity",
     "Employee / HR",
     "Health or other special category",
     "Financial"
    ],
    "legacy_single": true,
    "fills": [
     "personal_data_types",
     "special_category_data"
    ]
   },
   {
    "key": "data_subjects",
    "label": "Whose data?",
    "kind": "multiselect",
    "required": true,
    "options": [
     "Employees",
     "Customers",
     "Patients or trial subjects",
     "Suppliers"
    ],
    "legacy_single": true,
    "fills": [
     "data_subject_categories"
    ]
   },
   {
    "key": "transfer",
    "label": "Will data leave India?",
    "kind": "select",
    "required": true,
    "options": [
     "Yes",
     "No"
    ],
    "fills": [
     "processing_locations"
    ]
   },
