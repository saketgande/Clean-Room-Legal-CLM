   },
   {
    "key": "entity",
    "label": "Our legal entity",
    "kind": "text",
    "required": true
   },
   {
    "key": "entity_id",
    "label": "Our legal entity (from the register)",
    "kind": "text",
    "required": true
   },
   {
    "key": "counterparty",
    "label": "Counterparty",
    "kind": "text",
    "required": true
   },
   {
    "key": "counterparty_id",
    "label": "Counterparty (from the register)",
    "kind": "text",
    "required": true
   },
   {
    "key": "cp_signer_name",
    "label": "Their signer: name",
    "kind": "text",
    "required": true
   },
   {
    "key": "cp_signer_email",
    "label": "Their signer: email",
