 {
  "key": "dpa",
  "name": "Data Processing Agreement",
  "fields": [
   {
    "key": "parent_contract_id",
    "label": "Which agreement?",
    "kind": "text",
    "required": true
   },
   {
    "key": "cp_signer_name",
    "label": "Their signer: name",
    "kind": "text",
    "required": true
   },
   {
    "key": "cp_signer_email",
    "label": "Their signer: email",
    "kind": "email",
    "required": true
   },
   {
    "key": "paper",
    "label": "Whose paper?",
    "kind": "select",
    "required": true,
    "options": [
     "Our template",
     "Their paper"
    ]
   },
   {
    "key": "needed_by",
    "label": "Needed by",
    "kind": "date",
    "required": false
   },
   {
    "key": "our_role",
    "label": "Our role",
    "kind": "select",
    "required": true,
    "options": [
     "Controller: we decide how the data is used",
     "Processor: we act on their instructions"
    ]
