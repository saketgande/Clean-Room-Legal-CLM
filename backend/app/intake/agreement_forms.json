    "label": "Whose paper?",
    "kind": "select",
    "required": true,
    "options": [
     "Our template",
     "Their paper"
    ]
   },
   {
    "key": "needed_by",
    "label": "Needed by",
    "kind": "date",
    "required": false
   },
   {
    "key": "department",
    "label": "Requesting department",
    "kind": "select",
    "required": true,
    "options": [
     "Enterprise Systems",
     "Procurement",
     "Commercial",
     "R&D",
     "Human Resources",
     "Finance",
     "Quality"
    ]
   },
   {
    "key": "nda_kind",
    "label": "Mutual or one-way?",
    "kind": "select",
    "required": true,
    "options": [
     "Mutual",
     "One-way"
